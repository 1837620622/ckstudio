{
  "name": "ckstudio",
  "version": "1.1.0",
  "private": true,
  "description": "CK Studio — 传康KK personal portfolio (Cloudflare Pages)",
  "scripts": {
    "dev": "npx --yes serve -l 8765 .",
    "preview": "npx wrangler pages dev . --port 8788",
